---
export const prerender = false;

import { startProbeLoop, labelFor, appFor } from "../lib/probe.ts";
startProbeLoop(Number(process.env.YGG_MONITOR_INTERVAL_S ?? "50"));

// ── Time window (URL-driven — shareable links, browser back/forward work) ──
// hours = span (1..720 = the 30 d on-disk retention); end = epoch ms anchoring
// the right edge (omit = live "now"). Everything below reads these.
const WIN_HOURS = Math.max(1, Math.min(720, Number(Astro.url.searchParams.get("hours")) || 24));
const END_PARAM = Astro.url.searchParams.get("end");
const WIN_END = END_PARAM ? Math.min(Date.now(), Number(END_PARAM) || Date.now()) : Date.now();
const WIN_MS = WIN_HOURS * 3600 * 1000;
const WIN_START = WIN_END - WIN_MS;
const IS_LIVE = !END_PARAM;
const qWin = `hours=${WIN_HOURS}${IS_LIVE ? "" : `&end=${WIN_END}`}`;
// Number of buckets: keep ~144 for short spans, cap so a 30 d view stays ~10-min resolution.
const WIN_BUCKETS = Math.max(48, Math.min(288, Math.round(WIN_HOURS * 6)));
// Human label for the current span.
const spanLabel = WIN_HOURS < 1
  ? `${Math.round(WIN_HOURS * 60)} min`
  : WIN_HOURS < 48 ? `${WIN_HOURS} h` : `${(WIN_HOURS / 24).toFixed(WIN_HOURS % 24 ? 1 : 0)} d`;

interface Bucket {
  domain: string;
  layer: string;
  category: string;
  total: number;
  ok: number;
  bad: number;
  current: string;
  last_bad_ts: string | null;
  worst_streak_s: number;
  avg_ms: number;
}
interface TsPoint { ts_ms: number; avg_ms: number; n: number; bad_n: number; }

let buckets: Bucket[] = [];
let series: Record<string, TsPoint[]> = {};
let since: string | null = null;
let bucketSec: number = 600;
let error: string | null = null;
interface HostSample { ts: string; node: string; load_1m: number; load_5m: number | null; load_15m: number | null; mem_avail_kb: number | null; mem_total_kb: number | null; swap_used_kb: number | null; bench_worker: any; uptime_s: number | null; ygg_peers_up: number | null; ygg_peer_uptime_s: number | null; ygg_reconnects_1h: number | null; image_512_ok: boolean | null; image_structure: number | null; image_sd: number | null; image_probe_age_s: number | null; }
let hostSamples: HostSample[] = [];
try {
  const sm = await import("./api/summary.ts");
  const sUrl = `${Astro.url.origin}/api/summary?${qWin}`;
  const sRes = await sm.GET({ request: new Request(sUrl), url: new URL(sUrl) } as any);
  const sd = await sRes.json();
  buckets = sd.buckets ?? [];
  since = sd.since ?? null;

  const tm = await import("./api/timeseries.ts");
  const tUrl = `${Astro.url.origin}/api/timeseries?${qWin}&buckets=${WIN_BUCKETS}`;
  const tRes = await tm.GET({ request: new Request(tUrl), url: new URL(tUrl) } as any);
  const td = await tRes.json();
  series = td.series ?? {};
  bucketSec = td.bucket_seconds ?? 600;

  // Own1 host-metrics push samples (24 h window). Used for the correlation
  // panel — operator wants to see "load 64 spike at HH:MM" lined up against
  // "HTTPS bad at HH:MM" for john.demo.ownx.co.
  const hm = await import("./api/host-metrics.ts");
  const hUrl = `${Astro.url.origin}/api/host-metrics?node=own1&since=${WIN_HOURS}h${IS_LIVE ? "" : `&end=${WIN_END}`}`;
  const hRes = await hm.GET({ request: new Request(hUrl), url: new URL(hUrl) } as any);
  const hd = await hRes.json();
  hostSamples = hd.samples ?? [];
} catch (e: any) {
  error = e?.message ?? String(e);
}

const fmtSec = (s: number): string => {
  if (s < 60) return `${Math.round(s)}s`;
  if (s < 3600) return `${Math.floor(s / 60)}m ${Math.round(s % 60)}s`;
  if (s < 86400) return `${(s / 3600).toFixed(1)}h`;
  return `${(s / 86400).toFixed(1)}d`;
};

const dotFor = (c: string) =>
  c === "ok" ? { bg: "#1fa971", text: "OK" } :
  c === "bad" ? { bg: "#d6443d", text: "BAD" } :
  { bg: "#7a7a7a", text: "—" };

const labelForLayer = (l: string): string =>
  l === "dns" ? "DNS" : l === "https" ? "HTTPS" : l === "tcp" ? "TCP" : l;

const fmtTimeUtc = (ms: number): string => {
  const d = new Date(ms);
  const Y = d.getUTCFullYear();
  const M = String(d.getUTCMonth() + 1).padStart(2, "0");
  const D = String(d.getUTCDate()).padStart(2, "0");
  const h = String(d.getUTCHours()).padStart(2, "0");
  const m = String(d.getUTCMinutes()).padStart(2, "0");
  return `${Y}-${M}-${D} ${h}:${m}Z`;
};

const renderSparkline = (pts: TsPoint[]): string => {
  if (!pts || pts.length === 0) return "";
  const W = 360, H = 36, PADY = 4;
  const maxMs = Math.max(1, ...pts.map((p) => p.avg_ms));
  const bw = W / pts.length;

  // Anchor to the SELECTED window so it lines up with the host-metrics row.
  const nowMs = WIN_END;
  const windowMs = WIN_MS;
  const startMs = WIN_START;
  const tsAtBucket = (i: number) => startMs + ((i + 0.5) / pts.length) * windowMs;

  const bands: string[] = [];
  pts.forEach((p, i) => {
    if (p.bad_n > 0 && p.n > 0) {
      const opacity = Math.min(0.45, 0.12 + 0.5 * (p.bad_n / p.n));
      // Hover tooltip on outage bands — per-bucket bad rate.
      const tip = `${fmtTimeUtc(tsAtBucket(i))}\n${p.bad_n}/${p.n} bad (${((p.bad_n / p.n) * 100).toFixed(0)}%)`;
      bands.push(`<rect x="${(i * bw).toFixed(2)}" y="0" width="${bw.toFixed(2)}" height="${H}" fill="#d6443d" fill-opacity="${opacity.toFixed(2)}" data-tip="${tip.replace(/"/g, "&quot;")}"></rect>`);
    }
  });

  // Per-bucket circles (invisible by default, the polyline is the visual).
  // SVG native <title> gives free hover + tap tooltips with no JS.
  const dots: string[] = [];
  const pathPts: string[] = [];
  pts.forEach((p, i) => {
    if (p.n === 0) return;
    const x = (i + 0.5) * bw;
    const y = PADY + (H - 2 * PADY) * (1 - p.avg_ms / maxMs);
    pathPts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
    // Larger transparent hit-target circle on top of each datapoint for hover.
    const tip = `${fmtTimeUtc(tsAtBucket(i))}\n${p.avg_ms} ms avg · ${p.n} probes${p.bad_n > 0 ? ` · ${p.bad_n} bad` : ""}`;
    dots.push(`<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="8" fill="rgba(107,180,255,0.001)" data-tip="${tip.replace(/"/g, "&quot;")}"></circle>`);
  });
  const line = pathPts.length > 1
    ? `<polyline points="${pathPts.join(" ")}" fill="none" stroke="#6bb4ff" stroke-width="1.5" pointer-events="none" />`
    : "";

  return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" width="100%" height="${H}" style="display:block; cursor: crosshair;">${bands.join("")}${line}${dots.join("")}</svg>`;
};

// Sparkline for load values. Reuses same W/H + 24h time window as latency
// sparklines so spikes on this row line up visually with HTTPS/DNS BAD bands
// on the demo-box rows below — that is the whole point of this overlay.
//
// Time axis: now-24h on the left → now on the right. Samples are placed at
// their actual ts within that window. Gaps (push agent down) appear as gaps
// in the line — that's correct; we don't interpolate over missing data.
// Reconnects/hour over the window. Flat near zero is healthy; a raised plateau
// is a flapping uplink. Drawn on the same time axis as load and the latency
// sparklines so a flap plateau lines up visually with the HTTPS-bad bands on
// the rows below — which is the correlation that took an afternoon by hand.
// Image-health history. This is a PASS/FAIL band, not a line: the underlying
// measurement is "did a 512x512 generation come back as a picture or as noise",
// and there is no meaningful middle. Green where the box could make an image,
// red where it could not, grey where nobody asked.
//
// Same time axis as load and ygg so a degradation lines up against whatever
// else was happening. On 2026-08-23 the box went bad at 9h uptime and served
// six paid corrupt generations before a human noticed — this row is so that
// never needs a human again.
// Events strip: reboots and image failures on the shared time axis.
//
// Reboots are DERIVED, not reported: uptime_s going backwards between two
// consecutive samples is a restart, and the previous sample's uptime is how
// long the box had been up when it went down. That pairing is the whole value
// — "corrupt after 9h, rebooted, clean again" is the shape of this bug, and it
// is invisible if you only plot health.
const renderEventStrip = (samples: HostSample[]): string => {
  const W = 360, H = 36;
  const inWin = (samples ?? []).filter((s) => {
    const t = new Date(s.ts).getTime();
    return t >= WIN_START && t <= WIN_END;
  });
  if (inWin.length === 0) return "";
  const xFor = (t: number) => ((t - WIN_START) / WIN_MS) * W;
  const marks: string[] = [];

  // Every probe gets a tick: green for a real image, red for corrupt. Plotting
  // BOTH matters — a gap in green is itself a signal (the probe stopped, or the
  // box was down), and you cannot see a gap in a series that only marks
  // failures. Successes are short and semi-transparent so failures still read
  // first at a glance.
  const seen = new Set<string>();
  for (const p of inWin) {
    if (p.image_512_ok == null) continue;
    // The push runs every 60s and republishes the same hourly probe verdict;
    // dedupe on the probe's own age so one probe is one tick, not sixty.
    const t = new Date(p.ts).getTime();
    const probeAt = t - (p.image_probe_age_s ?? 0) * 1000;
    const key = `${Math.round(probeAt / 60000)}`;
    if (seen.has(key)) continue;
    seen.add(key);
    const x = xFor(probeAt);
    if (x < 0 || x > W) continue;
    const bad = p.image_512_ok === false;
    const tip = `${fmtTimeUtc(probeAt)}\n512x512 ${bad ? "CORRUPT" : "OK"}` +
      `${p.image_sd != null ? `\nsd ${p.image_sd} (healthy 40-70)` : ""}` +
      `${p.image_structure != null ? ` · structure ${p.image_structure}` : ""}` +
      `${p.uptime_s != null ? `\nuptime ${fmtSec(p.uptime_s)}` : ""}`;
    marks.push(bad
      ? `<rect x="${(x - 0.9).toFixed(2)}" y="8" width="1.8" height="${H - 8}" fill="#d6443d" fill-opacity="0.9" data-tip="${tip.replace(/"/g, "&quot;")}"></rect>`
      : `<rect x="${(x - 0.6).toFixed(2)}" y="20" width="1.2" height="${H - 20}" fill="#1fa971" fill-opacity="0.7" data-tip="${tip.replace(/"/g, "&quot;")}"></rect>`);
  }

  // Reboots — uptime_s went backwards.
  for (let i = 1; i < inWin.length; i++) {
    const prev = inWin[i - 1], cur = inWin[i];
    if (prev.uptime_s == null || cur.uptime_s == null) continue;
    if (cur.uptime_s >= prev.uptime_s) continue;
    const t = new Date(cur.ts).getTime();
    const x = xFor(t);
    const tip = `REBOOT\n${fmtTimeUtc(t)}\nprevious uptime ${fmtSec(prev.uptime_s)}`;
    marks.push(
      `<rect x="${(x - 1).toFixed(2)}" y="0" width="2" height="${H}" fill="#6bb4ff" data-tip="${tip.replace(/"/g, "&quot;")}"></rect>` +
      `<circle cx="${x.toFixed(2)}" cy="5" r="4" fill="#6bb4ff" data-tip="${tip.replace(/"/g, "&quot;")}"></circle>`);
  }
  if (marks.length === 0) return "";
  return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" width="100%" height="${H}" style="display:block; cursor: crosshair;">${marks.join("")}</svg>`;
};

const renderImageSparkline = (samples: HostSample[]): string => {
  const W = 360, H = 36;
  const pts = (samples ?? []).filter((s) => {
    const t = new Date(s.ts).getTime();
    return t >= WIN_START && t <= WIN_END && s.image_512_ok != null;
  });
  if (pts.length === 0) return "";
  const xFor = (t: number) => ((t - WIN_START) / WIN_MS) * W;
  // One band per sample, widened to the gap so sparse hourly data stays visible.
  const bands = pts.map((p, i) => {
    const t = new Date(p.ts).getTime();
    const next = i + 1 < pts.length ? new Date(pts[i + 1].ts).getTime() : Math.min(t + 3600_000, WIN_END);
    const x = xFor(t), w = Math.max(1.5, xFor(next) - x);
    const stale = (p.image_probe_age_s ?? 0) > 7200;
    const fill = stale ? "#7a7a7a" : p.image_512_ok ? "#1fa971" : "#d6443d";
    const tip = `${fmtTimeUtc(t)}\n512x512 ${p.image_512_ok ? "OK" : "CORRUPT"}` +
      `${p.image_structure != null ? `\nstructure ${p.image_structure}` : ""}` +
      `${p.image_sd != null ? ` · sd ${p.image_sd}` : ""}` +
      `${stale ? "\n(probe stale)" : ""}`;
    return `<rect x="${x.toFixed(2)}" y="0" width="${w.toFixed(2)}" height="${H}" fill="${fill}" fill-opacity="0.85" data-tip="${tip.replace(/"/g, "&quot;")}"></rect>`;
  });
  return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" width="100%" height="${H}" style="display:block; cursor: crosshair;">${bands.join("")}</svg>`;
};

const renderYggSparkline = (samples: HostSample[]): string => {
  const W = 360, H = 36, PADY = 4;
  const inWindow = (samples ?? []).filter((s) => {
    const t = new Date(s.ts).getTime();
    return t >= WIN_START && t <= WIN_END && s.ygg_reconnects_1h != null;
  });
  if (inWindow.length === 0) return "";
  // Scale to at least 20 so a healthy box reads as a flat line near the floor
  // rather than noise amplified to full height.
  const maxR = Math.max(20, ...inWindow.map((s) => s.ygg_reconnects_1h as number));
  const xFor = (t: number) => ((t - WIN_START) / WIN_MS) * W;
  const yFor = (r: number) => PADY + (H - 2 * PADY) * (1 - Math.min(r, maxR) / maxR);
  const bands: string[] = [];
  const pts: string[] = [];
  const dots: string[] = [];
  inWindow.forEach((s) => {
    const t = new Date(s.ts).getTime();
    const r = s.ygg_reconnects_1h as number;
    const x = xFor(t), y = yFor(r);
    pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
    if (r > 10) bands.push(`<rect x="${(x - 1).toFixed(1)}" y="0" width="2.5" height="${H}" fill="#d6443d" fill-opacity="0.28"></rect>`);
    dots.push(`<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="7" fill="rgba(255,177,104,0.001)" data-tip="${fmtTimeUtc(t)}\n${r} reconnects/h · ${s.ygg_peers_up ?? "?"} peers up"></circle>`);
  });
  const line = pts.length > 1 ? `<polyline points="${pts.join(" ")}" fill="none" stroke="#ffb168" stroke-width="1.5" pointer-events="none" />` : "";
  return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" width="100%" height="${H}" style="display:block; cursor: crosshair;">${bands.join("")}${line}${dots.join("")}</svg>`;
};

const renderLoadSparkline = (samples: HostSample[], nCores: number = 8): string => {
  const W = 360, H = 36, PADY = 4;
  // Selected window — same as the latency timeseries.
  const nowMs = WIN_END;
  const windowMs = WIN_MS;
  const startMs = WIN_START;

  // Filter to the window
  const inWindow = (samples ?? []).filter((s) => {
    const t = new Date(s.ts).getTime();
    return t >= startMs && t <= nowMs;
  });

  // Y axis: 0..max where max = max(2*nCores, observed peak). Anything beyond
  // 2x nCores is "extreme overcommit" — capped at the top of the chart.
  const observedMax = inWindow.length > 0 ? Math.max(...inWindow.map((s) => s.load_1m)) : 0;
  const maxLoad = Math.max(nCores * 2, observedMax);
  const yFor = (load: number): number => PADY + (H - 2 * PADY) * (1 - Math.min(load, maxLoad) / maxLoad);
  const xFor = (tMs: number): number => ((tMs - startMs) / windowMs) * W;

  // Red-zone band where load > nCores (overcommit territory — yggdrasil starves here)
  const overcommitY = yFor(nCores);
  const band = `<rect x="0" y="0" width="${W}" height="${overcommitY.toFixed(1)}" fill="#d6443d" fill-opacity="0.05" />`;
  // Reference line at load = nCores (where contention starts)
  const refLine = `<line x1="0" y1="${overcommitY.toFixed(1)}" x2="${W}" y2="${overcommitY.toFixed(1)}" stroke="#ffb168" stroke-opacity="0.25" stroke-dasharray="2,3" />`;

  if (inWindow.length === 0) {
    return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" width="100%" height="${H}" style="display:block">${band}${refLine}<text x="${W/2}" y="${H/2 + 4}" text-anchor="middle" fill="#666" font-size="10" font-family="ui-monospace, monospace">no samples in last 24h</text></svg>`;
  }

  // Render polyline. Gaps > 5 min split into separate polylines so we don't
  // draw misleading straight lines across long outages.
  const GAP_MS = 5 * 60 * 1000;
  const segments: string[][] = [[]];
  let prevMs: number | null = null;
  const sampleDots: string[] = [];
  for (const s of inWindow) {
    const t = new Date(s.ts).getTime();
    if (prevMs !== null && t - prevMs > GAP_MS) {
      segments.push([]);
    }
    const x = xFor(t);
    const y = yFor(s.load_1m);
    segments[segments.length - 1].push(`${x.toFixed(1)},${y.toFixed(1)}`);
    // Per-sample invisible hit target with tooltip — hover for full sample detail.
    const memFreeGb = s.mem_avail_kb != null ? (s.mem_avail_kb / 1024 / 1024).toFixed(1) + " GB free" : "—";
    const swapGb = s.swap_used_kb != null ? (s.swap_used_kb / 1024 / 1024).toFixed(1) + " GB used" : "—";
    // Mesh stability as seen FROM Own1 — the view xnode-1 structurally cannot have.
    const yggTip = s.ygg_reconnects_1h == null
      ? "ygg: not reported"
      : `ygg: ${s.ygg_peers_up ?? "?"} peers up · ${s.ygg_reconnects_1h} reconnects/h` +
        (s.ygg_reconnects_1h > 10 ? " · FLAPPING" : "");
    const benchState = s.bench_worker?.state ?? "—";
    const tip = `${fmtTimeUtc(t)}\nload ${s.load_1m.toFixed(2)} / ${(s.load_5m ?? 0).toFixed(2)} / ${(s.load_15m ?? 0).toFixed(2)} (1/5/15m)\nmem ${memFreeGb}\nswap ${swapGb}\nbench-worker: ${benchState}`;
    sampleDots.push(`<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="3.5" fill="transparent" stroke="transparent"><title>${tip}</title></circle>`);
    prevMs = t;
  }
  const lines = segments
    .filter((pts) => pts.length >= 1)
    .map((pts) =>
      pts.length === 1
        ? `<circle cx="${pts[0].split(",")[0]}" cy="${pts[0].split(",")[1]}" r="1.5" fill="#ffb168" pointer-events="none" />`
        : `<polyline points="${pts.join(" ")}" fill="none" stroke="#ffb168" stroke-width="1.5" pointer-events="none" />`
    )
    .join("");

  return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" width="100%" height="${H}" style="display:block; cursor: crosshair;">${band}${refLine}${lines}${sampleDots.join("")}</svg>`;
};

const latestHostSample: HostSample | null = hostSamples.length > 0 ? hostSamples[hostSamples.length - 1] : null;
// Hoisted rather than inlined: the Astro compiler will not parse optional
// chaining inside a class={`...${}`} attribute.
const imageCorrupt: boolean = latestHostSample != null && latestHostSample.image_512_ok === false;
const fmtKb = (kb: number | null): string => {
  if (kb === null || kb === undefined) return "—";
  if (kb < 1024) return `${kb} KB`;
  if (kb < 1024 * 1024) return `${(kb / 1024).toFixed(0)} MB`;
  return `${(kb / 1024 / 1024).toFixed(1)} GB`;
};

const CAT_TITLES: Record<string, string> = {
  relay: "Upstream Openmesh yggdrasil relay (root-cause indicator)",
  yggdrasil: "Yggdrasil-routed sites (depend on the relay)",
  direct: "Direct-routed sites (independent of the relay)",
};
const CAT_NOTES: Record<string, string> = {
  relay: "peer.yggdrasil.openmesh.cloud over public IPv4 — TCP handshake on TLS port 9003. If this is BAD, every yggdrasil-routed site below will also be BAD.",
  yggdrasil: "CNAME → 206-…yggdrasil.trustless.cloud. Reachability depends on the relay above + the trustless.cloud DNS proxy.",
  direct: "Apex A/AAAA on the operator's public IP — no mesh hop, no trustless.cloud chain.",
};
const CAT_ORDER: string[] = ["relay", "yggdrasil", "direct"];

const grouped = new Map<string, Map<string, Bucket[]>>();
for (const b of buckets) {
  let cat = grouped.get(b.category);
  if (!cat) { cat = new Map(); grouped.set(b.category, cat); }
  let arr = cat.get(b.domain);
  if (!arr) { arr = []; cat.set(b.domain, arr); }
  arr.push(b);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    {IS_LIVE && <meta http-equiv="refresh" content="30" />}
    <title>yggdrasil-monitor</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <style>
      body { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; background: #0e0e10; color: #e6e6e6; margin: 0; padding: 1.1rem 1.25rem; }
      h1 { font-weight: 600; margin: 0 0 0.2rem 0; font-size: 1.1rem; }
      h2 { font-size: 0.92rem; font-weight: 600; color: #e6e6e6; margin: 1rem 0 0.15rem 0; letter-spacing: 0.02em; }
      h2 small { color: #888; font-weight: 400; font-size: 0.78rem; display: block; margin-top: 0.15rem; }
      .meta { color: #888; font-size: 0.85rem; margin-bottom: 1rem; }
      .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; margin: 0.25rem 0 0.6rem 0; font-size: 0.8rem; }
      .ctl-label { color: #666; margin-right: 0.35rem; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.7rem; }
      .ctl-sep { color: #333; margin: 0 0.2rem; }
      .ctl { display: inline-block; padding: 2px 9px; border-radius: 5px; border: 1px solid #26262b;
        background: #16161a; color: #b9c6d6; text-decoration: none; font-variant-numeric: tabular-nums; transition: background 90ms, border-color 90ms; }
      .ctl:hover { background: #1e1e25; border-color: #3a3a44; color: #e6e6e6; }
      .ctl.active { background: #24405f; border-color: #3f6da0; color: #eaf2ff; }
      .ctl.live.active { background: #1c4a38; border-color: #1fa971; color: #d6ffe9; }
      .ctl.disabled { opacity: 0.35; pointer-events: none; }
      .ctl:focus-visible { outline: 2px solid #6bb4ff; outline-offset: 1px; }
      /* ── Status hero ─────────────────────────────────────────────── */
      .ygg-chip { margin-left: 0.5rem; font-size: 0.7rem; padding: 1px 7px; border-radius: 999px;
        border: 1px solid #2c4a3a; background: #12241c; color: #7ce8b5; font-weight: 600; white-space: nowrap; }
      .ygg-chip.flapping { border-color: #d6443d; background: #33131a; color: #ff9b93; }

      /* GPU producing corrupt images — deliberately NOT red.
         Red already means "endpoint is down" everywhere else on this board, and
         this failure is the opposite: every endpoint is up, every check passes,
         HTTP 200 with a valid PNG, and the pixels are garbage. It needs its own
         colour or it reads as just another outage. Purple, and the whole card
         is washed so it cannot be missed at a glance from across the room —
         which is the failure mode that actually happened: it was corrupt for
         six hours and nobody looked. */
      .section-host.image-corrupt { position: relative; }
      .section-host.image-corrupt::before {
        content: ""; position: absolute; inset: -0.4rem -0.6rem; border-radius: 12px;
        background: linear-gradient(180deg, rgba(139,92,246,0.20), rgba(139,92,246,0.09));
        border: 1px solid rgba(167,139,250,0.55); pointer-events: none; z-index: 0;
      }
      .section-host.image-corrupt > * { position: relative; z-index: 1; }
      .domain-card.image-corrupt-card { border-left: 3px solid #a78bfa; padding-left: 0.6rem; }
      .ygg-chip.image-bad { border-color: #a78bfa; background: #2a1b4d; color: #d6c7ff; }
      .image-corrupt-banner {
        display: block; margin: 0.35rem 0 0.5rem; padding: 0.3rem 0.6rem; border-radius: 6px;
        background: rgba(139,92,246,0.16); border: 1px solid rgba(167,139,250,0.45);
        color: #d6c7ff; font-size: 0.72rem; letter-spacing: 0.01em;
      }
      .hero { display: flex; align-items: center; gap: 0.6rem; border: 1px solid;
        border-radius: 10px; padding: 0.65rem 0.9rem; margin: 0 0 0.9rem 0; }
      .hero-dot { width: 9px; height: 9px; border-radius: 999px; flex: 0 0 auto;
        box-shadow: 0 0 0 3px rgba(255,255,255,0.06); }
      .hero-text { font-weight: 700; font-size: 0.95rem; letter-spacing: 0.01em; }
      .hero-sub { color: #9a9aa2; font-size: 0.75rem; margin-left: auto;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 46%; }
      @media (max-width: 640px) { .hero-sub { display: none; } }

      /* Rows: slightly more air and a real hover target. Density suits infra,
         but every row reading identically is what hid the outage. */
      .domain-card { border-top: 1px solid #1a1a1d; padding: 0.3rem 0; border-radius: 6px;
        transition: background 90ms; }
      .domain-card:hover { background: #131317; }
      /* A failing row should be findable by eye, not by reading every pill. */
      .domain-card.has-bad { box-shadow: inset 3px 0 0 #d6443d; padding-left: 0.5rem; }
      .summary { display: flex; align-items: baseline; gap: 0.5rem; cursor: pointer; padding: 0.1rem 0; }
      .summary:hover .domain-name { color: #fff; }
      .caret { color: #666; font-size: 0.62rem; flex: 0 0 auto; transition: transform 120ms; display: inline-block; }
      .domain-card.expanded .caret { transform: rotate(90deg); }
      .dots { margin-left: auto; display: flex; gap: 0.25rem; flex-wrap: wrap; justify-content: flex-end; }
      .mini-pill { font-size: 0.6rem; padding: 1px 6px; border-radius: 999px; color: #fff; font-weight: 600; white-space: nowrap; }
      .detail { display: none; padding: 0.1rem 0 0.25rem 1.05rem; }
      .domain-card.expanded .detail { display: block; }
      .domain-name { font-weight: 600; font-size: 0.92rem; padding-bottom: 0.25rem; }
      /* Region/operator, so a bare relay IP says WHERE it is without a lookup. */
      .domain-label { color: #888; font-weight: 400; font-size: 0.78rem; margin-left: 0.5rem; }
      /* Sub-heading inside a grouped card — one per hostname serving the app. */
      .host-head { color: #9aa; font-size: 0.78rem; font-family: ui-monospace, monospace; margin: 0.5rem 0 0.15rem; padding-top: 0.35rem; border-top: 1px solid #1e1e1e; }
      .host-head:first-child { border-top: none; padding-top: 0; margin-top: 0; }
      .diverge-chip { background: #3a2a10; color: #f0b429; border: 1px solid #6b4d12; border-radius: 3px; font-size: 0.66rem; padding: 0.05rem 0.35rem; margin-left: 0.35rem; letter-spacing: 0.02em; }
      .layer-row { display: grid; grid-template-columns: 60px 60px 100px 100px 100px 1fr; align-items: center; gap: 0.5rem; padding: 0.1rem 0; font-size: 0.8rem; }
      .layer { color: #888; }
      .pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 0.7rem; font-weight: 600; color: #fff; }
      .num { font-variant-numeric: tabular-nums; }
      .spark { background: #14141a; border-radius: 4px; }
      .err { color: #d6443d; padding: 1rem; background: rgba(214,68,61,0.1); border-radius: 8px; }
      .footer { color: #555; font-size: 0.75rem; margin-top: 2rem; }
      a { color: #6bb4ff; }
      .legend { color: #666; font-size: 0.72rem; margin: 0.25rem 0 1rem 0; }
      #ygg-tip { position: fixed; pointer-events: none; background: #1a1a1f; color: #e6e6e6;
        border: 1px solid #2a2a2e; border-radius: 4px; padding: 0.4rem 0.55rem;
        font: 0.72rem ui-monospace, "SF Mono", Menlo, Consolas, monospace; white-space: pre;
        z-index: 99; opacity: 0; transition: opacity 80ms; max-width: 320px; line-height: 1.35; }
      #ygg-tip.show { opacity: 1; }
      .legend span.swatch { display: inline-block; width: 10px; height: 10px; vertical-align: middle; margin: 0 4px 1px 8px; border-radius: 2px; }
      .section-relay h2 { color: #ffb168; }
      .section-yggdrasil h2 { color: #e6e6e6; }
      .big-divider { color: #555; font-size: 0.72rem; padding: 1rem 0 0.25rem 0; border-top: 2px dashed #2a2a2e; margin-top: 2.5rem; text-transform: uppercase; letter-spacing: 0.08em; }
      .section-direct { opacity: 0.62; }
      .section-direct h2 { color: #888; font-size: 0.82rem; }
      .section-direct h2 small { color: #555; }
      .section-direct .domain-name { font-weight: 500; color: #aaa; }
    </style>
  </head>
  <body>
    {(() => {
      // STATUS HERO. A monitoring board's first job is answering "is anything
      // wrong" from across the room, before anyone reads a row. Every row
      // previously carried identical weight, so six simultaneous failures
      // looked no different from none.
      const real = buckets.filter((b) => b.category !== "direct");
      const bad = real.filter((b) => b.current === "bad");
      const domsBad = [...new Set(bad.map((b) => b.domain))];
      const state = bad.length === 0 ? "ok" : bad.length >= real.length / 2 ? "critical" : "degraded";
      const bg = state === "ok" ? "#0f2a1e" : state === "critical" ? "#33131a" : "#33260f";
      const bd = state === "ok" ? "#1fa971" : state === "critical" ? "#d6443d" : "#d99a2b";
      const fg = state === "ok" ? "#7ce8b5" : state === "critical" ? "#ff9b93" : "#ffd08a";
      const headline = state === "ok"
        ? "All systems operational"
        : `${domsBad.length} host${domsBad.length === 1 ? "" : "s"} affected · ${bad.length} of ${real.length} checks failing`;
      return (
        <div class="hero" style={`background:${bg}; border-color:${bd};`}>
          <span class="hero-dot" style={`background:${bd};`}></span>
          <span class="hero-text" style={`color:${fg};`}>{headline}</span>
          <span class="hero-sub">{domsBad.slice(0, 4).join(" · ")}{domsBad.length > 4 ? ` +${domsBad.length - 4}` : ""}</span>
        </div>
      );
    })()}
    <h1>yggdrasil-monitor</h1>
    <div class="controls">
      <span class="ctl-label">Range</span>
      {([["1h",1],["6h",6],["24h",24],["3d",72],["7d",168],["30d",720]] as [string,number][]).map(([lbl,h]) => (
        <a class:list={["ctl", { active: WIN_HOURS === h }]}
           href={`?hours=${h}${IS_LIVE ? "" : `&end=${WIN_END}`}`}>{lbl}</a>
      ))}
      <span class="ctl-sep">·</span>
      <a class="ctl" href={`?hours=${WIN_HOURS}&end=${WIN_START}`} title="Back one window">&larr; older</a>
      {IS_LIVE
        ? <span class="ctl disabled" title="Already at the latest">newer &rarr;</span>
        : <a class="ctl" href={`?hours=${WIN_HOURS}&end=${Math.min(Date.now(), WIN_END + WIN_MS)}`} title="Forward one window">newer &rarr;</a>}
      <a class:list={["ctl", "live", { active: IS_LIVE }]} href={`?hours=${WIN_HOURS}`} title="Jump to now + resume auto-refresh">&#8635; Live</a>
    </div>
    <div class="meta">
      {spanLabel} window · {IS_LIVE ? "live · auto-refresh 30 s" : `history · ends ${fmtTimeUtc(WIN_END)}`} ·
      <span class="num">{fmtTimeUtc(WIN_START)}</span> &rarr; <span class="num">{fmtTimeUtc(WIN_END)}</span> ·
      <a href={`/api/summary?${qWin}`}>/api/summary</a> ·
      <a href={`/api/timeseries?${qWin}`}>/api/timeseries</a>
    </div>
    <div class="legend">
      Sparkline: line = average latency, <span class="swatch" style="background:#d6443d;opacity:0.45"></span>red band = outage window
      · Bucket = {Math.round(bucketSec/60)} min · Vantage: xnode-1 over public internet
    </div>

    {error && <div class="err">Summary fetch error: {error}</div>}

    {hostSamples.length > 0 && (
      <section class={imageCorrupt ? "section section-host image-corrupt" : "section section-host"}>
        <h2 style="color:#ffb168;">Own1 host metrics
          <small>Pushed every ~60 s from Own1. Orange line = 1m load avg over 24h. Dashed = overcommit threshold (load &gt; #cores). Red tinted zone above the threshold is when yggdrasil keepalives start to starve.</small>
        </h2>
        <div class={imageCorrupt ? "domain-card image-corrupt-card" : "domain-card"}>
          <div class="domain-name">own1
            {latestHostSample && (
              <span style="color:#888; font-weight:400; font-size:0.78rem; margin-left:0.5rem;">
                · load {latestHostSample.load_1m.toFixed(2)} / {latestHostSample.load_5m?.toFixed(2) ?? "—"} / {latestHostSample.load_15m?.toFixed(2) ?? "—"} (1m / 5m / 15m)
                · mem {fmtKb(latestHostSample.mem_avail_kb)} free of {fmtKb(latestHostSample.mem_total_kb)}
                · swap {fmtKb(latestHostSample.swap_used_kb)} used
              </span>
            )}
            {latestHostSample && latestHostSample.ygg_reconnects_1h != null && (
              /* Mesh stability as seen FROM Own1 — the view xnode-1 structurally
                 cannot have. On 2026-08-22 this read 103/h while the board showed
                 the relays healthy, because they ARE healthy from xnode-1; it is
                 Own1's own session to them that collapses. */
              <span class={imageCorrupt ? "ygg-chip image-bad" : "ygg-chip"}
                    title="One 512x512 generation per hour, scored for GPU corruption. The failure is silent — HTTP 200 with a valid PNG full of noise — so this is the only thing that can see it.">
                {latestHostSample.image_512_ok == null
                  ? "image 512 · unknown"
                  : latestHostSample.image_512_ok
                    ? "image 512 OK"
                    : "image 512 CORRUPT"}
              </span>
              <span class={`ygg-chip${latestHostSample.ygg_reconnects_1h > 10 ? " flapping" : ""}`}>
                ygg {latestHostSample.ygg_peers_up ?? "?"} peers · {latestHostSample.ygg_reconnects_1h} reconnects/h{latestHostSample.ygg_reconnects_1h > 10 ? " · FLAPPING" : ""}
              </span>
            )}
          </div>
          <div class="layer-row">
            <div class="layer">load</div>
            <div><span class="pill" style={`background:${latestHostSample && latestHostSample.load_1m > 8 ? "#d6443d" : "#1fa971"}`}>{latestHostSample ? latestHostSample.load_1m.toFixed(1) : "—"}</span></div>
            <div class="num">{hostSamples.length} samples</div>
            <div class="num">—</div>
            <div class="num">—</div>
            <div class="spark" set:html={renderLoadSparkline(hostSamples)} />
          </div>
          {imageCorrupt && (
            <div class="image-corrupt-banner">
              GPU is returning corrupt images — 512×512 generations come back as
              noise with HTTP 200 and a valid PNG, so every other check on this
              board still reads green. memegen and comicgen "square" are affected.
              A reboot restores it.
            </div>
          )}
          {hostSamples.length > 1 && (
            <div class="layer-row">
              <div class="layer">events</div>
              <div><span class="pill" style="background:#6bb4ff">{(() => { let n = 0; for (let i = 1; i < hostSamples.length; i++) { const a = hostSamples[i - 1].uptime_s, b = hostSamples[i].uptime_s; if (a != null && b != null && b < a) n++; } return n; })()}</span></div>
              <div class="num">reboots</div>
              <div class="num">{hostSamples.filter((h) => h.image_512_ok === false).length} bad gens</div>
              <div class="num">{latestHostSample?.uptime_s != null ? `up ${fmtSec(latestHostSample.uptime_s)}` : "—"}</div>
              <div class="spark" set:html={renderEventStrip(hostSamples)} />
            </div>
          )}
          {hostSamples.some((h) => h.image_512_ok != null) && (
            <div class="layer-row">
              <div class="layer">image</div>
              <div><span class="pill" style={`background:${latestHostSample?.image_512_ok === false ? "#d6443d" : latestHostSample?.image_512_ok ? "#1fa971" : "#7a7a7a"}`}>{latestHostSample?.image_512_ok === false ? "BAD" : latestHostSample?.image_512_ok ? "OK" : "—"}</span></div>
              <div class="num">512×512</div>
              <div class="num">sd {latestHostSample?.image_sd ?? "—"}</div>
              <div class="num">{latestHostSample?.image_probe_age_s != null ? `${fmtSec(latestHostSample.image_probe_age_s)} ago` : "—"}</div>
              <div class="spark" set:html={renderImageSparkline(hostSamples)} />
            </div>
          )}
          {hostSamples.some((h) => h.ygg_reconnects_1h != null) && (
            <div class="layer-row">
              <div class="layer">ygg</div>
              <div><span class="pill" style={`background:${(latestHostSample?.ygg_reconnects_1h ?? 0) > 10 ? "#d6443d" : "#1fa971"}`}>{latestHostSample?.ygg_reconnects_1h ?? "—"}/h</span></div>
              <div class="num">{latestHostSample?.ygg_peers_up ?? "—"} peers up</div>
              <div class="num">{latestHostSample?.ygg_peer_uptime_s != null && latestHostSample.ygg_peer_uptime_s >= 0 ? fmtSec(latestHostSample.ygg_peer_uptime_s) : "—"}</div>
              <div class="num">—</div>
              <div class="spark" set:html={renderYggSparkline(hostSamples)} />
            </div>
          )}
        </div>
      </section>
    )}

    {CAT_ORDER.map((cat) => {
      const cm = grouped.get(cat);
      if (!cm || cm.size === 0) return null;
      // FAILING FIRST. Alphabetical order gives an outage and a healthy row the
      // same prominence; on 2026-08-22 the six dead rows were scattered through
      // the list. Worst-affected first, then name for stability.
      const badness = (dn: string) => {
        const rs = cm.get(dn)!;
        const b = rs.filter((r) => r.current === "bad").length;
        return b === 0 ? 0 : b / rs.length + 1;
      };
      const domains = [...cm.keys()].sort((a, b) => {
        const d = badness(b) - badness(a);
        return d !== 0 ? d : a.localeCompare(b);
      });
      // Fold hostnames that serve the SAME app into one card. Both rows keep
      // being probed and shown — if one name is green and the other red, the
      // fault is that DNS record and not Own1, which is the whole reason the
      // second row exists. Grouping removes the visual duplication without
      // removing the comparison.
      const appGroups = [];
      const seenApp = new Map();
      for (const dn of domains) {
        const a = appFor(dn);
        if (a) {
          const at = seenApp.get(a);
          if (at != null) { appGroups[at].hosts.push(dn); continue; }
          seenApp.set(a, appGroups.length);
          appGroups.push({ key: a, app: a, hosts: [dn] });
        } else {
          appGroups.push({ key: dn, hosts: [dn] });
        }
      }
      return (
        <section class={`section section-${cat}`}>
          {cat === "direct" && <div class="big-divider">Reference group — sites that don't depend on the yggdrasil relay (the rest of this page is dimmed)</div>}
          <h2>{CAT_TITLES[cat] ?? cat}<small>{CAT_NOTES[cat] ?? ""}</small></h2>
          {appGroups.map((g) => {
            const hostRows = g.hosts.map((h) => ({ host: h, rows: cm.get(h)! }));
            const anyBad = hostRows.some((h) => h.rows.some((r) => r.current === "bad"));
            const byLayer = new Map();
            for (const h of hostRows) {
              for (const r of h.rows) {
                if (!byLayer.has(r.layer)) byLayer.set(r.layer, new Set());
                byLayer.get(r.layer)!.add(r.current);
              }
            }
            // Same app, two names, one green one red = that DNS record is the
            // fault, not Own1. Say it out loud — telling those two apart is the
            // only reason the second name is probed at all.
            const diverges = hostRows.length > 1 &&
              [...byLayer.values()].some((s) => s.has("ok") && s.has("bad"));
            const worst = (layer) => {
              const s = byLayer.get(layer)!;
              return s.has("bad") ? "bad" : s.has("ok") ? "ok" : [...s][0];
            };
            const layers = [...byLayer.keys()];
            // A group of one is just a row — keep its hostname and its label.
            const multi = g.hosts.length > 1;
            const title = multi ? g.app : g.hosts[0];
            return (
              <div class={`domain-card collapsible${anyBad ? " has-bad" : ""}`}>
                <div class="summary">
                  <span class="caret">▸</span>
                  <span class="domain-name">{title}
                    {multi
                      ? <span class="domain-label">{g.hosts.length} names</span>
                      : labelFor(title) && <span class="domain-label">{labelFor(title)}</span>}
                  </span>
                  <span class="dots">
                    {layers.map((L) => {
                      const p = dotFor(worst(L));
                      return (
                        <span class="mini-pill" style={`background:${p.bg}`} title={`${labelForLayer(L)}: ${p.text}`}>{labelForLayer(L)}</span>
                      );
                    })}
                    {diverges && <span class="diverge-chip" title="One hostname is up and another is down for the same app — suspect that DNS record, not Own1.">DNS divergence</span>}
                  </span>
                </div>
                <div class="detail">
                {hostRows.map((h) => (
                  <Fragment>
                    {multi && (
                      <div class="host-head">{h.host}
                        {labelFor(h.host) && <span class="domain-label">{labelFor(h.host)}</span>}
                      </div>
                    )}
                    {h.rows.map((r) => {
                      const p = dotFor(r.current);
                      const svg = renderSparkline(series[`${r.domain}::${r.layer}`] ?? []);
                      return (
                        <div class="layer-row">
                          <div class="layer">{labelForLayer(r.layer)}</div>
                          <div><span class="pill" style={`background:${p.bg}`}>{p.text}</span></div>
                          <div class="num">{r.ok}/{r.total}</div>
                          <div class="num">{r.avg_ms} ms</div>
                          <div class="num">{r.worst_streak_s > 0 ? fmtSec(r.worst_streak_s) : "—"}</div>
                          <div class="spark" set:html={svg} />
                        </div>
                      );
                    })}
                  </Fragment>
                ))}
                </div>
              </div>
            );
          })}
        </section>
      );
    })}

    <div class="footer">Built on xnode-1 · single Node process · probe loop fires every {Math.round(bucketSec/60)} min · 30 d on-disk retention.</div>
    <div id="ygg-tip" role="tooltip"></div>
    <script is:inline>
      // Tooltip: any SVG element with data-tip shows a positioned panel on hover/tap.
      // Pointer events instead of mouse only — works for touch + stylus too.
      (function () {
        const tip = document.getElementById('ygg-tip');
        if (!tip) return;
        const show = (e, txt) => {
          tip.textContent = txt;
          const pad = 10;
          let x = e.clientX + pad, y = e.clientY + pad;
          // Flip to left/up if near right/bottom edge
          const rect = tip.getBoundingClientRect();
          if (x + 320 > window.innerWidth) x = e.clientX - 320 - pad;
          if (y + rect.height > window.innerHeight) y = e.clientY - rect.height - pad;
          tip.style.left = x + 'px';
          tip.style.top = y + 'px';
          tip.classList.add('show');
        };
        const hide = () => tip.classList.remove('show');
        document.addEventListener('pointermove', (e) => {
          const t = e.target;
          if (t && t.getAttribute && t.getAttribute('data-tip')) {
            show(e, t.getAttribute('data-tip'));
          } else {
            hide();
          }
        });
        document.addEventListener('pointerleave', hide);
        document.addEventListener('pointercancel', hide);
        // Tap-anywhere-else dismisses (mobile).
        document.addEventListener('pointerdown', (e) => {
          const t = e.target;
          if (!t || !t.getAttribute || !t.getAttribute('data-tip')) hide();
        });
      })();
      // Collapsible rows — EXPANDED BY DEFAULT since 2026-08-22.
      //
      // They used to default closed to keep the board on one screen. That cost
      // more than it saved: on 2026-08-22 every ygg row was failing and the
      // sparklines — which show WHEN each one started and whether it is solid
      // or flapping — were one click away each. The difference between "down
      // solid for 6h" and "bad 735/1957 with a 0.1h worst streak" is the whole
      // diagnosis, and it was hidden by default.
      //
      // Collapse is remembered per row in localStorage, browser-only: anyone
      // who prefers a compact board keeps one, and it never leaves the machine.
      (() => {
        const KEY = 'ygg-monitor.collapsed.v1';
        let collapsed;
        try {
          collapsed = new Set(JSON.parse(localStorage.getItem(KEY) || '[]'));
        } catch (e) {
          collapsed = new Set();   // a corrupt value must not blank the board
        }
        const save = () => {
          try {
            localStorage.setItem(KEY, JSON.stringify([...collapsed]));
          } catch (e) {
            /* private mode / quota — the board still works, it just forgets */
          }
        };
        document.querySelectorAll('.domain-card.collapsible').forEach((card) => {
          // Identify by the row's own label, not its index: rows get added and
          // reordered (three were renamed today), and an index-keyed preference
          // would silently collapse the wrong row after any such change.
          const nameEl = card.querySelector('.domain-name');
          const id = (nameEl && nameEl.textContent ? nameEl.textContent.trim() : '');
          if (!collapsed.has(id)) card.classList.add('expanded');
          const sum = card.querySelector('.summary');
          if (!sum) return;
          sum.addEventListener('click', () => {
            const nowExpanded = card.classList.toggle('expanded');
            if (nowExpanded) collapsed.delete(id); else collapsed.add(id);
            save();
          });
        });
      })();
    </script>
  </body>
</html>
